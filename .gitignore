# Oversized data archives (exceed GitHub's 100 MB file limit)
data/*.npz
data/*.npz.bak

# Per-shard ingest output from parallel_ingest.py --keep-shards. `data/*.npz`
# above does not cover these: they live one level down, in a directory named
# after the merged archive (data/<name>.npz.shards/shard_000.npz).
data/*.shards/

# Vocabularies and the sentence index are written beside whichever archive
# produced them (ingest keys the path off --out), so a run targeting data/
# drops generated copies there. The canonical, tracked copies live in ingest/.
data/*_vocabulary.txt
data/sentence_index*.json

# Visualizer database (exceeds GitHub's 100 MB file limit)
viz/cushr_viz.db

# Build artifacts and compiled binaries
*.exe
*.o
cushr_cpu/cushr_tests

# Training caches: extracted .npy mirrors of the featurized npz, ~1.4 GB EACH.
# The trailing glob matters -- the per-featurizer caches are cache75_morph43/,
# cache75_ngrams80/, ... and a bare `cache/` rule misses every one of them.
cushr_train/cache/
cushr_train/cache*/
cushr_train/edge_score*.npy

# Learned featurizer weights materialised beside a dense archive in data/.
# (The cushr_train/model_*.featurizer.pt siblings ARE tracked -- they are part
# of the committed model set -- so this is scoped to data/ only.)
data/*.featurizer.pt

# ByT5 comparison scratch: their inference repo is cloned on the cluster and
# the inputs/outputs are regenerated per run. The clone especially must stay
# out -- an embedded git repository makes `git add .` stage a gitlink instead
# of the files, and unpicking that afterwards is a nuisance.
cushr_train/byt5-sanskrit-analyzers/
cushr_train/byt5_in/
cushr_train/byt5_out/
cushr_train/byt5_preds_*.jsonl

# Slurm job logs (job id in the name, so they accumulate one pair per run)
cushr_train/*.o[0-9]*
cushr_train/*.e[0-9]*
cushr_gpu/*.o[0-9]*
cushr_gpu/*.e[0-9]*

# Python bytecode
__pycache__/
*.pyc
# ByT5 comparison scratch — cloned/generated on the cluster, never committed
cushr_train/byt5-sanskrit-analyzers/
cushr_train/byt5_in/
cushr_train/byt5_out/
cushr_train/byt5_preds_*.jsonl
cushr_train/byt5_infer.o*
cushr_train/byt5_infer.e*
# K4 (week 10) GPU run outputs. Scoped to cushr_gpu/ to match data/*.npz above.
# gpu_k32_K32.npz is 155 MB (top-32 candidate paths for all 119,503 sentences),
# regenerated by row E of bench_k4.slurm, and is an intermediate consumed by
# gpu_paths_to_rerank.py -- not a result. The k4_bench_*.csv files and the
# ncu_k4_*.ncu-rep profiler reports ARE tracked: they are the measurements, and
# the .ncu-rep files match the ncu_batched_*/ncu_kbest_* reports already in git.
cushr_gpu/*.npz
cushr_gpu/cushr_score_tests
